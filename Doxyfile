# Doxygen configuration for FalconGuide.
# The existing docs/architecture.md file is intentionally not part of INPUT.

PROJECT_NAME           = "FalconGuide"
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "Visual-Inertial GNSS Navigation System"
OUTPUT_DIRECTORY       = build/doxygen

INPUT                  = README.md \
                         src
FILE_PATTERNS          = *.hpp \
                         *.cpp \
                         *.md
RECURSIVE              = YES
EXCLUDE                = docs
USE_MDFILE_AS_MAINPAGE = README.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = YES

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
TYPEDEF_HIDES_STRUCT   = NO
LOOKUP_CACHE_SIZE      = 0

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SKIP_FUNCTION_MACROS   = YES

HAVE_DOT               = NO
